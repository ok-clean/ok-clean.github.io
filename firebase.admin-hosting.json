{
  "hosting": {
    "site": "okclean-admin-app",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {"source": "/", "destination": "/admin/", "type": 302}
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Cache-Control", "value": "no-store"}
        ]
      }
    ]
  }
}

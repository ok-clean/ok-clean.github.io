 "faq": [
  {
   "q": "견적은 어떻게 정해지나요?",
   "a": "평수와 서비스 종류, 추가 옵션으로 기본 금액이 정해지고, 오염 정도와 구조에 따라 현장에서 조정될 수 있어요. 사진을 보내주시면 더 정확하게 알려드려요."
  },
  {
   "q": "어느 지역까지 가나요?",
   "a": "춘천과 강원도 전역을 중심으로 작업하고, 수도권도 일정에 따라 방문해요. 주소를 알려주시면 가능 여부를 바로 안내해 드려요."
  },
  {
   "q": "작업 시간은 얼마나 걸리나요?",
   "a": "집 크기와 상태에 따라 달라요. 상담할 때 예상 시간을 함께 안내해 드려요."
  },
  {
   "q": "작업 후 아쉬운 부분이 있으면요?",
   "a": "작업이 끝나면 함께 확인하고, 아쉬운 부분은 사진과 함께 알려주시면 보완 방법을 안내해 드려요."
  },
  {
   "q": "주말·공휴일도 되나요?",
   "a": "일정에 따라 가능해요. 원하는 날짜를 문의할 때 함께 적어 주세요."
  }
 ],
